{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('code').val() === 'ebarasoroku' : true)",
        ".validate": "newData.hasChildren(['code', 'joinedAt'])",
        "code": {
          ".validate": "newData.val() === 'ebarasoroku'"
        },
        "joinedAt": {
          ".validate": "newData.isNumber()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "provider": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "grade": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "orders": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "history": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "presets": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "helpText": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "calendarEvents": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "printerReservations": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "dutyRotation": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "dutyOverrides": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    },
    "projects": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()"
    }
  }
}
