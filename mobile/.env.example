# ライブラリ機能(Cloudflare Worker)のURL。worker/ をデプロイして発行されたURLを設定してください。
EXPO_PUBLIC_WORKER_URL=https://butumu-library.<your-subdomain>.workers.dev

# Google ログイン用のクライアントID。
# iOS は IOS、Android と Web は WEB を使います。未設定ならその端末では
# Google ボタンが出ず、メール/パスワードのみ使えます。
# Android は別途 Firebase Console でパッケージ名と署名鍵の SHA-1 を登録した
# Android アプリが必要です(クライアントIDをここに書く必要はありません)。
# 取得: Firebase Console > Authentication > Sign-in method > Google
#       > ウェブ SDK 構成 > ウェブ クライアント ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
