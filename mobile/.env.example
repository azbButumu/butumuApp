# ライブラリ機能(Cloudflare Worker)のURL。worker/ をデプロイして発行されたURLを設定してください。
EXPO_PUBLIC_WORKER_URL=https://butumu-library.<your-subdomain>.workers.dev

# Google ログイン用のクライアントID。
# 動かす端末に対応するものが必要です(iOS なら IOS、Android なら ANDROID、
# Web なら WEB)。未設定ならその端末では Google ボタンが出ず、
# メール/パスワードのみ使えます。
# 取得: Firebase Console > プロジェクトの設定 > 全般 > マイアプリ
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
